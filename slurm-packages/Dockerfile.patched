ARG BASE_IMAGE=cr.eu-north1.nebius.cloud/ml-containers/neubuntu:noble-20260202145316

FROM $BASE_IMAGE

ARG SLURM_VERSION
ARG SLURM_TARBALL_URL
ARG SLURM_TARBALL_SHA256
ARG SLURM_PATCHSET=baseline
ARG LD_LIBRARY_PATH

ARG OPENMPI_VERSION=4.1.9a1
ARG OPENMPI_SUBVERSION=1.20250722.92f9fca4eb.2507097
ARG MELLANOX_REPO_URL=https://linux.mellanox.com/public/repo/doca/3.1.0

ARG DEBIAN_FRONTEND=noninteractive

# Install dependencies
RUN apt install -y --update \
        git  \
        build-essential \
        devscripts \
        debhelper \
        fakeroot \
        wget \
        curl \
        equivs \
        autoconf \
        pkg-config \
        libssl-dev \
        libpam0g-dev \
        libtool \
        libjansson-dev \
        libjson-c-dev \
        munge \
        libmunge-dev \
        libjwt2 \
        libjwt-dev \
        libhwloc-dev \
        liblz4-dev \
        flex \
        libevent-dev \
        jq \
        squashfs-tools \
        zstd \
        zlib1g \
        zlib1g-dev \
        libpmix-dev

COPY slurm-packages/apply-patch-series.sh /opt/slurm-build/apply-patch-series.sh
COPY slurm-packages/patches/ /opt/slurm-build/patches/

# Download and verify the exact release archive from the release manifest.
RUN cd /usr/src && \
    test -n "${SLURM_TARBALL_URL}" && \
    test -n "${SLURM_TARBALL_SHA256}" && \
    case "${SLURM_PATCHSET}" in *[!a-zA-Z0-9._-]*|'') exit 2 ;; esac && \
    curl --fail --location --retry 5 --retry-all-errors \
      --output slurm-${SLURM_VERSION}.tar.bz2 "${SLURM_TARBALL_URL}" && \
    echo "${SLURM_TARBALL_SHA256}  slurm-${SLURM_VERSION}.tar.bz2" | sha256sum -c - && \
    tar -xvf slurm-${SLURM_VERSION}.tar.bz2 && \
    rm -f slurm-${SLURM_VERSION}.tar.bz2 && \
    test "$(awk '$1 == "Version:" {print $2; exit}' slurm-${SLURM_VERSION}/META)" = "${SLURM_VERSION}" && \
    /opt/slurm-build/apply-patch-series.sh \
      /usr/src/slurm-${SLURM_VERSION} \
      /opt/slurm-build/patches/${SLURM_VERSION}/${SLURM_PATCHSET}/series \
      /usr/src/slurm-${SLURM_VERSION}/.product-patches.sha256

# Install Openmpi
RUN ARCH="$(dpkg --print-architecture)" && \
    case "$ARCH" in \
      amd64) MLNX_ARCH=x86_64 ;; \
      arm64) MLNX_ARCH=arm64 ;; \
      *) echo "Unsupported architecture: $ARCH" && exit 1 ;; \
    esac && \
    echo "deb ${MELLANOX_REPO_URL}/ubuntu24.04/${MLNX_ARCH} ./" > /etc/apt/sources.list.d/mellanox_doca.list && \
    wget -qO - https://linux.mellanox.com/public/repo/doca/GPG-KEY-Mellanox.pub | apt-key add - && \
    apt update && \
    apt install openmpi=${OPENMPI_VERSION}-${OPENMPI_SUBVERSION}

ENV PATH=/usr/mpi/gcc/openmpi-${OPENMPI_VERSION}/bin:$PATH

# Build deb packages for Slurm
RUN cd /usr/src/slurm-${SLURM_VERSION} && \
    ARCH=$(uname -m) && \
    sed -i "s|--with-pmix\b|--with-pmix=/usr/lib/${ARCH}-linux-gnu/pmix2|" debian/rules && \
    mk-build-deps -i debian/control -t "apt-get -o Debug::pkgProblemResolver=yes --no-install-recommends -y" && \
    debuild -b -uc -us

# Move deb files
RUN mkdir /usr/src/debs && \
    mv /usr/src/*.deb /usr/src/debs/ && \
    cp /usr/src/slurm-${SLURM_VERSION}/.product-patches.sha256 \
      /usr/src/debs/product-patches.sha256
